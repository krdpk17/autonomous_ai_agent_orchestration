# Remote Hermes Inference Endpoint
HERMES_BASE_URL="https://openrouter.ai/api/v1"
HERMES_API_KEY="your_remote_api_key_here"
HERMES_MODEL="nousresearch/hermes-3-llama-3.1-405b"

# Local Redis Configuration
# Use 'localhost' when running python directly on your Mac.
# Use 'redis' when running inside Docker Compose.
REDIS_HOST="localhost"
REDIS_PORT=6379